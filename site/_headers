# Cloudflare Pages response headers.
# The only third-party origin the site talks to is Umami (script + /api/send),
# so everything else is locked down.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'none'; script-src https://umami.riddellious.dev; connect-src https://umami.riddellious.dev; style-src 'self'; img-src 'self' data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

/admin/*
  X-Robots-Tag: noindex
